<?xml version="1.0" encoding="utf-8"?>
<!--
    Android 12+ splash requires an AdaptiveIconDrawable. A flat PNG here
    silently falls back to the launcher icon and looks clipped. Keep this
    file identical in structure to mipmap-anydpi-v26/ic_launcher.xml so
    that the splash matches the icon on the launcher exactly.
-->
<adaptive-icon xmlns:android="http://schemas.android.com/apk/res/android">
    <background android:drawable="@color/launch_bg" />
    <foreground>
        <inset
            android:drawable="@drawable/ic_launcher_foreground"
            android:inset="14%" />
    </foreground>
</adaptive-icon>
